{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{.agents/**,.git/**,convex/**,design-concepts/**,docs/**,node_modules/**,public/**,src/**,tests/**,tmp/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/photo-upload",
      "destination": "https://fearless-gopher-60.convex.site/api/photo-upload"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "https://fearless-gopher-60.convex.site/api/auth/:path*"
    }
  ]
}
